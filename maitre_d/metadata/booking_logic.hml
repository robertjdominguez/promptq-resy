kind: DataConnectorLink
version: v1
definition:
  name: booking_logic
  url:
    readWriteUrls:
      read:
        valueFromEnv: MAITRE_D_BOOKING_LOGIC_READ_URL
      write:
        valueFromEnv: MAITRE_D_BOOKING_LOGIC_WRITE_URL
  headers:
    Authorization:
      valueFromEnv: MAITRE_D_BOOKING_LOGIC_AUTHORIZATION_HEADER
  schema:
    version: v0.1
    schema:
      scalar_types:
        Boolean:
          representation:
            type: boolean
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
        Float:
          representation:
            type: float64
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
        String:
          representation:
            type: string
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
      object_types:
        CityCode:
          fields:
            code:
              type:
                name: String
                type: named
        Coordinates:
          fields:
            lat:
              type:
                name: Float
                type: named
            lon:
              type:
                name: Float
                type: named
        QueryInfo:
          fields:
            day:
              type:
                name: String
                type: named
            limit:
              type:
                type: nullable
                underlying_type:
                  name: Float
                  type: named
            location_id:
              type:
                name: String
                type: named
            party_size:
              type:
                name: Float
                type: named
            time_filter:
              type:
                type: nullable
                underlying_type:
                  name: String
                  type: named
            url_slug:
              type:
                type: nullable
                underlying_type:
                  name: String
                  type: named
        ResySuggestionResponse:
          fields:
            query:
              type:
                name: QueryInfo
                type: named
            results:
              type:
                element_type:
                  name: ResySuggestionResult
                  type: named
                type: array
        ResySuggestionResult:
          fields:
            venue:
              type:
                name: Venue
                type: named
        Venue:
          fields:
            average_bill_size:
              type:
                name: Float
                type: named
            currency_symbol:
              type:
                name: String
                type: named
            hospitality_included:
              type:
                name: Float
                type: named
            id:
              type:
                name: Venue_id
                type: named
            is_gdc:
              type:
                name: Float
                type: named
            is_global_dining_access:
              type:
                name: Boolean
                type: named
            is_global_dining_access_only:
              type:
                name: Boolean
                type: named
            name:
              type:
                name: String
                type: named
            price_range:
              type:
                name: Float
                type: named
            requires_reservation_transfers:
              type:
                name: Float
                type: named
            resy_select:
              type:
                name: Float
                type: named
            type:
              type:
                name: String
                type: named
            url_slug:
              type:
                name: String
                type: named
            venue_group:
              type:
                name: VenueGroup
                type: named
        Venue_id:
          fields:
            resy:
              type:
                name: Float
                type: named
        VenueGroup:
          fields:
            id:
              type:
                name: Float
                type: named
            name:
              type:
                name: String
                type: named
            venues:
              type:
                element_type:
                  name: Float
                  type: named
                type: array
      collections: []
      functions:
        - name: getLatLon
          description: This function fetches the coordinates of a city using the OpenCage Geocoding API.
          arguments:
            city:
              description: '- The city to get the coordinates for'
              type:
                name: String
                type: named
          result_type:
            name: Coordinates
            type: named
        - name: getCityCode
          description: This function takes a pair of coordinates, and returns a city code from the Resy API.
          arguments:
            coordinates:
              description: '- The coordinates to get the city code for'
              type:
                name: Coordinates
                type: named
          result_type:
            name: CityCode
            type: named
        - name: getRestaurants
          description: This function takes in a city code, the current date, and a party size to show the list of restaurants with availability.
          arguments: {}
          result_type:
            name: ResySuggestionResponse
            type: named
      procedures: []
    capabilities:
      version: 0.1.6
      capabilities:
        query:
          variables: {}
          nested_fields: {}
        mutation: {}
