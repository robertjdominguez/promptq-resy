kind: DataConnectorLink
version: v1
definition:
  name: booking_logic
  url:
    readWriteUrls:
      read:
        valueFromEnv: MAITRE_D_BOOKING_LOGIC_READ_URL
      write:
        valueFromEnv: MAITRE_D_BOOKING_LOGIC_WRITE_URL
  headers:
    Authorization:
      valueFromEnv: MAITRE_D_BOOKING_LOGIC_AUTHORIZATION_HEADER
  schema:
    version: v0.1
    schema:
      scalar_types:
        Float:
          representation:
            type: float64
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
        String:
          representation:
            type: string
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
      object_types:
        Coordinates:
          fields:
            lat:
              type:
                name: Float
                type: named
            lon:
              type:
                name: Float
                type: named
      collections: []
      functions:
        - name: getLatLon
          description: This function fetches the coordinates of a city using the OpenCage Geocoding API.
          arguments:
            city:
              description: '- The city to get the coordinates for'
              type:
                name: String
                type: named
          result_type:
            name: Coordinates
            type: named
      procedures: []
    capabilities:
      version: 0.1.6
      capabilities:
        query:
          variables: {}
          nested_fields: {}
        mutation: {}
