---
kind: ObjectType
version: v1
definition:
  name: restaurant
  fields:
    - name: id
      type: Float!
    - name: image_url
      type: String
    - name: name
      type: String!
    - name: neighborhood
      type: String!
    - name: price_range
      type: Float!
    - name: rating
      type: Float!
    - name: total_ratings
      type: Float!
    - name: type
      type: String!
    - name: url_slug
      type: String!
  graphql:
    typeName: restaurant
    inputTypeName: restaurant_input
  dataConnectorTypeMapping:
    - dataConnectorName: booking_logic
      dataConnectorObjectType: Restaurant
      fieldMapping:
        id:
          column:
            name: id
        image_url:
          column:
            name: imageUrl
        name:
          column:
            name: name
        neighborhood:
          column:
            name: neighborhood
        price_range:
          column:
            name: priceRange
        rating:
          column:
            name: rating
        total_ratings:
          column:
            name: totalRatings
        type:
          column:
            name: type
        url_slug:
          column:
            name: urlSlug

---
kind: TypePermissions
version: v1
definition:
  typeName: restaurant
  permissions:
    - role: admin
      output:
        allowedFields:
          - id
          - image_url
          - name
          - neighborhood
          - price_range
          - rating
          - total_ratings
          - type
          - url_slug
    - role: user
      output:
        allowedFields:
          - id
          - image_url
          - name
          - neighborhood
          - price_range
          - rating
          - total_ratings
          - type
          - url_slug

---
kind: Command
version: v1
definition:
  name: get_restaurants
  outputType: "[restaurant!]!"
  arguments:
    - name: city_code
      type: String!
    - name: date
      type: String!
      description: "- The date to get the restaurants for in YYYY-MM-DD format"
    - name: party_size
      type: String!
      description: "- The party size to get the restaurants for"
  source:
    dataConnectorName: booking_logic
    dataConnectorCommand:
      function: getRestaurants
  graphql:
    rootFieldName: get_restaurants
    rootFieldKind: Query
  description: This function takes in a city code, the current date, and a party
    size to show the list of restaurants with availability.

---
kind: CommandPermissions
version: v1
definition:
  commandName: get_restaurants
  permissions:
    - role: admin
      allowExecution: true
    - role: user
      allowExecution: true

