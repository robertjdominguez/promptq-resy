kind: DataConnectorLink
version: v1
definition:
  name: user_logic
  url:
    readWriteUrls:
      read:
        valueFromEnv: MAITRE_D_USER_LOGIC_READ_URL
      write:
        valueFromEnv: MAITRE_D_USER_LOGIC_WRITE_URL
  headers:
    Authorization:
      valueFromEnv: MAITRE_D_USER_LOGIC_AUTHORIZATION_HEADER
  schema:
    version: v0.1
    schema:
      scalar_types:
        String:
          representation:
            type: string
          aggregate_functions: {}
          comparison_operators:
            _eq:
              type: equal
      object_types: {}
      collections: []
      functions: []
      procedures:
        - name: insertUser
          description: |-
            This is a convenience function that — absent of a built-out UI — inserts a user into the database.
            The following fields are required:
          arguments:
            auth_token:
              description: '- The auth token of the user in Resy'
              type:
                name: String
                type: named
            email:
              description: '- The email of the user'
              type:
                name: String
                type: named
            payment_id:
              description: |-
                - The payment ID of the user in Resy

                The function will return a JWT that can be used to authenticate the user in the app.
              type:
                name: String
                type: named
          result_type:
            name: String
            type: named
    capabilities:
      version: 0.1.6
      capabilities:
        query:
          variables: {}
          nested_fields: {}
        mutation: {}
