---
kind: ObjectType
version: v1
definition:
  name: city_code
  fields:
    - name: code
      type: String!
  graphql:
    typeName: city_code
    inputTypeName: city_code_input
  dataConnectorTypeMapping:
    - dataConnectorName: booking_logic
      dataConnectorObjectType: CityCode

---
kind: TypePermissions
version: v1
definition:
  typeName: city_code
  permissions:
    - role: admin
      output:
        allowedFields:
          - code
    - role: user
      output:
        allowedFields:
          - code

---
kind: Command
version: v1
definition:
  name: get_city_code
  outputType: city_code!
  arguments:
    - name: coordinates
      type: coordinates!
      description: "- The coordinates to get the city code for"
  source:
    dataConnectorName: booking_logic
    dataConnectorCommand:
      function: getCityCode
  graphql:
    rootFieldName: get_city_code
    rootFieldKind: Query
  description: |
      This function takes in a latitude and longitude and returns a city code from Resy.
      It should be used before the get_restaurants function to determine the city code for a user's
      desired city.

---
kind: CommandPermissions
version: v1
definition:
  commandName: get_city_code
  permissions:
    - role: admin
      allowExecution: true
    - role: user
      allowExecution: true

